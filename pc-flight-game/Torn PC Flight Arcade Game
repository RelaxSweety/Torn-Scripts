                );
        }

        // ========================================================
        // DESTROY
        // ========================================================

        function destroyGame() {

            clearInterval(
                travelTimer
            );

            cancelAnimationFrame(
                animationFrame
            );

            resizeObserver.disconnect();

            window.removeEventListener(
                'keydown',
                keyDown,
                true
            );

            window.removeEventListener(
                'keyup',
                keyUp,
                true
            );

            root.remove();

            activeGame =
                null;
        }

        // ========================================================
        // PAUSE
        // ========================================================

        function togglePause() {

            if (ended) {
                return;
            }

            paused =
                !paused;

            keys.clear();

            pauseButton.textContent =
                paused
                    ? 'RESUME'
                    : 'PAUSE';

            if (paused) {

                message.innerHTML = `

<div class="dialog">

    <h2>
        PAUSED
    </h2>

    <p>
        Game Time:
        <strong>
            ${formatGameTime(playTime)}
        </strong>
    </p>

    <p>
        Closing the window while paused
        preserves this game.
    </p>

</div>

`;

                message.style.display =
                    'flex';

            } else {

                message.style.display =
                    'none';

                last =
                    performance.now();
            }
        }

        // ========================================================
        // MINIMIZE
        // ========================================================

        function minimizeGame() {

            if (ended) {
                return;
            }

            minimized = true;
            paused = true;

            keys.clear();

            root.classList.add(
                'tfa-minimized'
            );

            pauseButton.textContent =
                'RESUME';
        }

        // ========================================================
        // RESTORE
        // ========================================================

        function restoreGame() {

            if (ended) {
                return;
            }

            minimized = false;
            paused = true;

            keys.clear();

            root.classList.remove(
                'tfa-minimized'
            );

            pauseButton.textContent =
                'RESUME';

            message.innerHTML = `

<div class="dialog">

    <h2>
        PAUSED
    </h2>

    <p>
        Player:
        <strong>
            ${escapeHtml(username)}
        </strong>
    </p>

    <p>
        Game Time:
        <strong>
            ${formatGameTime(playTime)}
        </strong>
    </p>

    <p>
        Your previous game has been restored.
    </p>

</div>

`;

            message.style.display =
                'flex';

            last =
                performance.now();

            requestAnimationFrame(
                resize
            );
        }

        // ========================================================
        // CLOSE
        // ========================================================

        function closeGame() {

            if (ended) {
                return;
            }

            if (paused) {

                minimizeGame();

                return;
            }

            finishGame(
                'closed'
            );
        }

        // ========================================================
        // UPDATE
        // ========================================================

        function update(dt) {

            if (
                paused ||
                minimized ||
                ended
            ) {
                return;
            }

            playTime += dt;
            elapsed += dt;

            score +=
                dt * 8;

            player.cooldown =
                Math.max(
                    0,
                    player.cooldown - dt
                );

            player.invincible =
                Math.max(
                    0,
                    player.invincible - dt
                );

            let dx = 0;
            let dy = 0;

            if (
                keys.has('ArrowLeft') ||
                keys.has('KeyA')
            ) {
                dx--;
            }

            if (
                keys.has('ArrowRight') ||
                keys.has('KeyD')
            ) {
                dx++;
            }

            if (
                keys.has('ArrowUp') ||
                keys.has('KeyW')
            ) {
                dy--;
            }

            if (
                keys.has('ArrowDown') ||
                keys.has('KeyS')
            ) {
                dy++;
            }

            if (
                dx &&
                dy
            ) {
                dx *= .707;
                dy *= .707;
            }

            player.x =
                Math.max(
                    15,
                    Math.min(
                        width * .55,
                        player.x +
                        dx *
                        player.speed *
                        dt
                    )
                );

            player.y =
                Math.max(
                    18,
                    Math.min(
                        height -
                        player.height -
                        18,

                        player.y +
                        dy *
                        player.speed *
                        dt
                    )
                );

            if (
                keys.has('Space') &&
                player.cooldown <= 0
            ) {
                shoot();
            }

            enemyTimer -= dt;

            if (
                enemyTimer <= 0
            ) {

                spawnEnemy();

                const rate =
                    Math.max(
                        .34,
                        1.15 -
                        elapsed *
                        .006
                    );

                enemyTimer =
                    rate *
                    (
                        .65 +
                        Math.random() *
                        .7
                    );
            }

            cloudTimer -= dt;

            if (
                cloudTimer <= 0
            ) {

                clouds.push({

                    x:
                        width + 100,

                    y:
                        30 +
                        Math.random() *
                        height *
                        .7,

                    scale:
                        .5 +
                        Math.random() *
                        1.4,

                    speed:
                        20 +
                        Math.random() *
                        35
                });

                cloudTimer =
                    .5 +
                    Math.random() *
                    1.6;
            }

            clouds.forEach(
                cloud => {

                    cloud.x -=
                        cloud.speed *
                        dt;
                }
            );

            clouds =
                clouds.filter(
                    cloud =>
                        cloud.x >
                        -180
                );

            bullets.forEach(
                bullet => {

                    bullet.x +=
                        bullet.vx *
                        dt;
                }
            );

            bullets =
                bullets.filter(
                    bullet =>
                        bullet.x <
                        width + 40
                );

            enemies.forEach(
                enemy => {

                    enemy.x +=
                        enemy.vx *
                        dt;

                    enemy.wave +=
                        dt * 2;

                    enemy.y +=
                        Math.sin(
                            enemy.wave
                        ) *
                        enemy.amplitude *
                        dt;

                    enemy.fire -=
                        dt;

                    if (
                        enemy.fire <= 0 &&
                        enemy.x <
                        width - 80
                    ) {

                        const angle =
                            Math.atan2(
                                player.y -
                                enemy.y,

                                player.x -
                                enemy.x
                            );

                        const speed =
                            220 +
                            Math.min(
                                elapsed,
                                100
                            );

                        enemyBullets.push({

                            x:
                                enemy.x,

                            y:
                                enemy.y +
                                enemy.height / 2,

                            width:
                                8,

                            height:
                                5,

                            vx:
                                Math.cos(
                                    angle
                                ) *
                                speed,

                            vy:
                                Math.sin(
                                    angle
                                ) *
                                speed
                        });

                        enemy.fire =
                            1.2 +
                            Math.random() *
                            1.7;
                    }

                    if (
                        collision(
                            player,
                            enemy,
                            6
                        )
                    ) {

                        enemy.hp =
                            0;

                        damage(
                            enemy.tough
                                ? 30
                                : 20
                        );

                        explosion(
                            enemy.x,
                            enemy.y,
                            15
                        );
                    }
                }
            );

            enemyBullets.forEach(
                bullet => {

                    bullet.x +=
                        bullet.vx *
                        dt;

                    bullet.y +=
                        bullet.vy *
                        dt;

                    if (
                        collision(
                            player,
                            bullet,
                            4
                        )
                    ) {

                        bullet.dead =
                            true;

                        damage(12);
                    }
                }
            );

            enemyBullets =
                enemyBullets.filter(
                    bullet =>

                        !bullet.dead &&

                        bullet.x >
                        -30 &&

                        bullet.x <
                        width + 30 &&

                        bullet.y >
                        -30 &&

                        bullet.y <
                        height + 30
                );

            for (
                const bullet of bullets
            ) {

                for (
                    const enemy of enemies
                ) {

                    if (
                        !bullet.dead &&
                        enemy.hp > 0 &&
                        collision(
                            bullet,
                            enemy
                        )
                    ) {

                        bullet.dead =
                            true;

                        enemy.hp--;

                        explosion(
                            bullet.x,
                            bullet.y,
                            4
                        );

                        if (
                            enemy.hp <= 0
                        ) {

                            kills++;

                            score +=
                                enemy.tough
                                    ? 300
                                    : 120;

                            explosion(
                                enemy.x +
                                enemy.width / 2,

                                enemy.y +
                                enemy.height / 2,

                                enemy.tough
                                    ? 24
                                    : 15
                            );
                        }
                    }
                }
            }

            bullets =
                bullets.filter(
                    bullet =>
                        !bullet.dead
                );

            enemies =
                enemies.filter(
                    enemy =>

                        enemy.hp > 0 &&

                        enemy.x >
                        -120 &&

                        enemy.y >
                        -80 &&

                        enemy.y <
                        height + 80
                );

            particles.forEach(
                particle => {

                    particle.x +=
                        particle.vx *
                        dt;

                    particle.y +=
                        particle.vy *
                        dt;

                    particle.vx *=
                        .985;

                    particle.vy *=
                        .985;

                    particle.life -=
                        dt;
                }
            );

            particles =
                particles.filter(
                    particle =>
                        particle.life >
                        0
                );

            if (
                score >
                highScore
            ) {
                highScore =
                    Math.floor(
                        score
                    );
            }
        }

        // ========================================================
        // DRAW PLANE
        // ========================================================

        function drawPlane(
            x,
            y,
            flipped,
            enemy,
            tough
        ) {

            ctx.save();

            ctx.translate(
                x +
                (
                    flipped
                        ? 65
                        : 0
                ),
                y
            );

            if (flipped) {
                ctx.scale(
                    -1,
                    1
                );
            }

            ctx.fillStyle =
                enemy
                    ? (
                        tough
                            ? '#6f1d1d'
                            : '#79402f'
                    )
                    : '#c7c3b6';

            ctx.strokeStyle =
                '#171717';

            ctx.lineWidth =
                2;

            ctx.beginPath();

            ctx.moveTo(
                2,
                17
            );

            ctx.lineTo(
                18,
                10
            );

            ctx.lineTo(
                47,
                9
            );

            ctx.lineTo(
                63,
                15
            );

            ctx.lineTo(
                48,
                20
            );

            ctx.lineTo(
                18,
                21
            );

            ctx.closePath();

            ctx.fill();
            ctx.stroke();

            ctx.fillStyle =
                enemy
                    ? '#8c4a35'
                    : '#8e918c';

            ctx.beginPath();

            ctx.moveTo(
                26,
                12
            );

            ctx.lineTo(
                35,
                -4
            );

            ctx.lineTo(
                43,
                -4
            );

            ctx.lineTo(
                38,
                13
            );

            ctx.closePath();

            ctx.fill();
            ctx.stroke();

            ctx.beginPath();

            ctx.moveTo(
                27,
                19
            );

            ctx.lineTo(
                38,
                35
            );

            ctx.lineTo(
                46,
                35
            );

            ctx.lineTo(
                39,
                18
            );

            ctx.closePath();

            ctx.fill();
            ctx.stroke();

            ctx.fillStyle =
                enemy
                    ? '#3d1712'
                    : '#526b76';

            ctx.fillRect(
                43,
                10,
                8,
                6
            );

            ctx.strokeStyle =
                '#bbb';

            ctx.beginPath();

            ctx.moveTo(
                64,
                5
            );

            ctx.lineTo(
                64,
                26
            );

            ctx.stroke();

            ctx.restore();
        }

        // ========================================================
        // DRAW
        // ========================================================

        function draw() {

            if (minimized) {
                return;
            }

            const gradient =
                ctx.createLinearGradient(
                    0,
                    0,
                    0,
                    height
                );

            gradient.addColorStop(
                0,
                '#07131d'
            );

            gradient.addColorStop(
                .6,
                '#173345'
            );

            gradient.addColorStop(
                1,
                '#584c3d'
            );

            ctx.fillStyle =
                gradient;

            ctx.fillRect(
                0,
                0,
                width,
                height
            );

            clouds.forEach(
                cloud => {

                    ctx.save();

                    ctx.globalAlpha =
                        .12;

                    ctx.fillStyle =
                        '#dbe6eb';

                    ctx.beginPath();

                    ctx.ellipse(
                        cloud.x,
                        cloud.y,
                        55 *
                        cloud.scale,
                        16 *
                        cloud.scale,
                        0,
                        0,
                        Math.PI * 2
                    );

                    ctx.fill();

                    ctx.restore();
                }
            );

            ctx.fillStyle =
                '#111816';

            ctx.beginPath();

            ctx.moveTo(
                0,
                height
            );

            for (
                let x = 0;
                x <= width;
                x += 80
            ) {

                const y =
                    height -
                    28 -

                    Math.sin(
                        (
                            x +
                            elapsed *
                            35
                        ) /
                        150
                    ) *
                    18 -

                    Math.sin(
                        (
                            x +
                            elapsed *
                            50
                        ) /
                        47
                    ) *
                    7;

                ctx.lineTo(
                    x,
                    y
                );
            }

            ctx.lineTo(
                width,
                height
            );

            ctx.closePath();

            ctx.fill();

            ctx.fillStyle =
                '#ffd35a';

            bullets.forEach(
                bullet => {

                    ctx.fillRect(
                        bullet.x,
                        bullet.y,
                        bullet.width,
                        bullet.height
                    );
                }
            );

            ctx.fillStyle =
                '#ff684f';

            enemyBullets.forEach(
                bullet => {

                    ctx.fillRect(
                        bullet.x,
                        bullet.y,
                        bullet.width,
                        bullet.height
                    );
                }
            );

            enemies.forEach(
                enemy => {

                    drawPlane(
                        enemy.x,
                        enemy.y,
                        true,
                        true,
                        enemy.tough
                    );
                }
            );

            if (
                player.invincible <= 0 ||

                Math.floor(
                    player.invincible *
                    14
                ) %
                2 === 0
            ) {

                drawPlane(
                    player.x,
                    player.y,
                    false,
                    false,
                    false
                );
            }

            particles.forEach(
                particle => {

                    ctx.save();

                    ctx.globalAlpha =
                        Math.max(
                            0,
                            particle.life /
                            particle.maxLife
                        );

                    ctx.fillStyle =
                        particle.life > .35
                            ? '#f0a33a'
                            : '#777';

                    ctx.beginPath();

                    ctx.arc(
                        particle.x,
                        particle.y,
                        particle.radius,
                        0,
                        Math.PI * 2
                    );

                    ctx.fill();

                    ctx.restore();
                }
            );

            ctx.fillStyle =
                '#0008';

            ctx.fillRect(
                12,
                12,
                205,
                122
            );

            ctx.fillStyle =
                '#eee';

            ctx.font =
                'bold 13px Arial';

            ctx.fillText(
                `TIME    ${formatGameTime(playTime)}`,
                24,
                35
            );

            ctx.fillText(
                `SCORE   ${formatNumber(score)}`,
                24,
                58
            );

            ctx.fillText(
                `KILLS   ${kills}`,
                24,
                81
            );

            ctx.fillText(
                `HEALTH  ${Math.max(0, Math.floor(health))}`,
                24,
                104
            );

            ctx.fillText(
                `HIGH    ${formatNumber(highScore)}`,
                24,
                127
            );
        }

        // ========================================================
        // LOOP
        // ========================================================

        function loop(now) {

            const dt =
                Math.min(
                    .033,
                    (
                        now -
                        last
                    ) /
                    1000 ||
                    0
                );

            last =
                now;

            update(dt);

            draw();

            animationFrame =
                requestAnimationFrame(
                    loop
                );
        }

        // ========================================================
        // KEYBOARD
        // ========================================================

        function keyDown(event) {

            if (
                minimized ||
                ended
            ) {
                return;
            }

            if (
                [
                    'ArrowUp',
                    'ArrowDown',
                    'ArrowLeft',
                    'ArrowRight',
                    'Space'
                ].includes(
                    event.code
                )
            ) {
                event.preventDefault();
            }

            if (
                event.code ===
                'Escape'
            ) {

                event.preventDefault();

                closeGame();

                return;
            }

            if (
                event.code ===
                'KeyP' &&
                !event.repeat
            ) {

                event.preventDefault();

                togglePause();

                return;
            }

            keys.add(
                event.code
            );
        }

        function keyUp(event) {

            keys.delete(
                event.code
            );
        }

        window.addEventListener(
            'keydown',
            keyDown,
            true
        );

        window.addEventListener(
            'keyup',
            keyUp,
            true
        );

        pauseButton.addEventListener(
            'click',
            togglePause
        );

        closeButton.addEventListener(
            'click',
            closeGame
        );

        activeGame = {
            restore:
                restoreGame,

            minimize:
                minimizeGame,

            destroy:
                destroyGame
        };

        animationFrame =
            requestAnimationFrame(
                loop
            );
    }

    // ============================================================
    // INITIALIZATION
    // ============================================================

    injectStyles();

    ensureLauncher();

    const observer =
        new MutationObserver(
            () => {

                clearTimeout(
                    observer._timer
                );

                observer._timer =
                    setTimeout(
                        ensureLauncher,
                        350
                    );
            }
        );

    observer.observe(
        document.documentElement,
        {
            childList:
                true,

            subtree:
                true
        }
    );

    setInterval(
        ensureLauncher,
        3000
