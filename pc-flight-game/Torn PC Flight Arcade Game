    // ============================================================
    // CHAT INPUT DETECTION
    // ============================================================

    function getChatInputs() {

        const selectors = [

            'textarea[placeholder*="message" i]',

            'textarea[placeholder*="chat" i]',

            '[contenteditable="true"][data-placeholder*="message" i]',

            '[contenteditable="true"][aria-label*="message" i]',

            '[contenteditable="true"][role="textbox"]'
        ];

        const found =
            new Set();

        for (const selector of selectors) {

            document
                .querySelectorAll(selector)
                .forEach(el => {

                    if (
                        el.closest(`#${ROOT_ID}`) ||
                        el.closest(`#${SHARE_ID}`)
                    ) {
                        return;
                    }

                    if (
                        !elementVisible(el)
                    ) {
                        return;
                    }

                    found.add(el);
                });
        }

        return [...found];
    }

    // ============================================================
    // CHAT WINDOW DETECTION
    //
    // IMPORTANT:
    //
    // The previous versions stopped at the first plausible
    // container above the input.
    //
    // That often meant the script selected the MESSAGE BODY,
    // not the complete Torn chat window.
    //
    // This version walks upward and keeps the OUTERMOST
    // reasonable floating chat container.
    // ============================================================

    function findChatContainer(input) {

        if (!input) {
            return null;
        }

        let current =
            input.parentElement;

        let bestCandidate =
            null;

        while (
            current &&
            current !== document.body &&
            current !== document.documentElement
        ) {

            const rect =
                current.getBoundingClientRect();

            /*
             * Ignore invisible ancestors.
             */

            if (
                rect.width > 0 &&
                rect.height > 0
            ) {

                /*
                 * Reasonable dimensions for Torn's floating
                 * chat windows.
                 *
                 * We deliberately keep walking upward instead
                 * of returning immediately.
                 */

                if (
                    rect.width >= 220 &&
                    rect.width <= 700 &&
                    rect.height >= 160 &&
                    rect.height <=
                        window.innerHeight * .95
                ) {
                    bestCandidate =
                        current;
                }
            }

            current =
                current.parentElement;
        }

        return (
            bestCandidate ||
            input.parentElement?.parentElement ||
            input.parentElement ||
            input
        );
    }

    // ============================================================
    // CHAT HEADER DETECTION
    //
    // THIS IS THE MAJOR v1.7.4 CHANGE.
    //
    // Once the OUTER chat window is identified, only the
    // TOP HEADER STRIP is permitted to supply the chat name.
    //
    // Message transcript text below the header is ignored.
    // ============================================================

    function detectChatName(
        container,
        input,
        index
    ) {

        if (!container) {
            return (
                `Open Chat ${index + 1}`
            );
        }

        const windowRect =
            container.getBoundingClientRect();

        /*
         * First try elements explicitly carrying title-like
         * metadata inside the header.
         */

        const metadataElements =
            container.querySelectorAll(
                '[title], [aria-label]'
            );

        const metadataCandidates =
            [];

        for (
            const el of metadataElements
        ) {

            if (
                !elementVisible(el)
            ) {
                continue;
            }

            const rect =
                el.getBoundingClientRect();

            const centerY =
                rect.top +
                rect.height / 2;

            /*
             * HARD HEADER BOUNDARY.
             */

            if (
                centerY <
                    windowRect.top - 5 ||
                centerY >
                    windowRect.top + 70
            ) {
                continue;
            }

            const value =
                cleanText(
                    el.getAttribute('title') ||
                    el.getAttribute('aria-label')
                );

            if (
                !value ||
                value.length < 2 ||
                value.length > 40
            ) {
                continue;
            }

            if (
                /close|minimize|maximize|options|settings|send|message|emoji|profile/i
                    .test(value)
            ) {
                continue;
            }

            metadataCandidates.push({
                text: value,
                left:
                    rect.left -
                    windowRect.left,
                top:
                    rect.top -
                    windowRect.top
            });
        }

        if (
            metadataCandidates.length
        ) {

            metadataCandidates.sort(
                (a, b) => {

                    const idealLeft = 60;

                    const aScore =
                        Math.abs(
                            a.left -
                            idealLeft
                        ) +
                        Math.abs(a.top) * 2;

                    const bScore =
                        Math.abs(
                            b.left -
                            idealLeft
                        ) +
                        Math.abs(b.top) * 2;

                    return (
                        aScore -
                        bScore
                    );
                }
            );

            /*
             * Only return metadata if it resembles an actual
             * chat title rather than a generic UI label.
             */

            for (
                const candidate of
                metadataCandidates
            ) {

                if (
                    !/^(chat|private chat|private chats|your private chats)$/i
                        .test(candidate.text)
                ) {
                    return candidate.text;
                }
            }
        }

        /*
         * Now inspect visible text nodes/elements, but ONLY
         * inside the header geometry.
         */

        const elements =
            container.querySelectorAll(
                'span, div, a, strong, b, h1, h2, h3, h4'
            );

        const candidates =
            [];

        for (
            const el of elements
        ) {

            if (
                !elementVisible(el)
            ) {
                continue;
            }

            const rect =
                el.getBoundingClientRect();

            /*
             * Must actually lie within the detected chat window.
             */

            if (
                rect.left <
                    windowRect.left - 2 ||

                rect.right >
                    windowRect.right + 2 ||

                rect.top <
                    windowRect.top - 2 ||

                rect.bottom >
                    windowRect.bottom + 2
            ) {
                continue;
            }

            const centerY =
                rect.top +
                rect.height / 2;

            /*
             * ABSOLUTE RULE:
             *
             * Nothing below the top 70 pixels can become
             * the chat name.
             */

            if (
                centerY >
                    windowRect.top + 70
            ) {
                continue;
            }

            /*
             * Large wrappers often contain both the header
             * and transcript. Never use them.
             */

            if (
                rect.height > 55 ||
                rect.width >
                    windowRect.width * .78
            ) {
                continue;
            }

            /*
             * Prefer leaf-like elements.
             */

            if (
                el.children.length > 2
            ) {
                continue;
            }

            const text =
                cleanText(
                    el.textContent
                );

            if (
                !text ||
                text.length < 2 ||
                text.length > 40
            ) {
                continue;
            }

            /*
             * Reject controls.
             */

            if (
                /^(close|minimize|maximize|options|settings|send|message|chat|private chat|private chats|your private chats)$/i
                    .test(text)
            ) {
                continue;
            }

            /*
             * Reject dates and timestamps.
             */

            if (
                /^today\b/i.test(text) ||
                /^yesterday\b/i.test(text) ||
                /^\d{1,2}:\d{2}/.test(text) ||
                /^\d{1,2}\/\d{1,2}/.test(text)
            ) {
                continue;
            }

            /*
             * Reject message UI.
             */

            if (
                /last message/i.test(text) ||
                /type your message/i.test(text) ||
                /send message/i.test(text)
            ) {
                continue;
            }

            const relativeLeft =
                rect.left -
                windowRect.left;

            const relativeTop =
                rect.top -
                windowRect.top;

            /*
             * The Torn title should be in the left/middle
             * portion of the header, not where close/minimize
             * controls live.
             */

            if (
                relativeLeft >
                    windowRect.width * .72
            ) {
                continue;
            }

            candidates.push({
                text,
                relativeLeft,
                relativeTop,
                width:
                    rect.width,
                height:
                    rect.height
            });
        }

        if (
            !candidates.length
        ) {
            return (
                `Open Chat ${index + 1}`
            );
        }

        /*
         * Torn headers generally resemble:
         *
         * [avatar] Walterwh1      — ×
         *
         * [avatar] MrsPuff        — ×
         *
         * [icon]   Chaos Cartel   — ×
         *
         * The name therefore usually begins around
         * 35–90px from the left edge.
         */

        candidates.sort(
            (a, b) => {

                const idealLeft = 60;
                const idealTop = 10;

                const aScore =
                    Math.abs(
                        a.relativeLeft -
                        idealLeft
                    ) +

                    Math.abs(
                        a.relativeTop -
                        idealTop
                    ) * 2 +

                    a.text.length * .1;

                const bScore =
                    Math.abs(
                        b.relativeLeft -
                        idealLeft
                    ) +

                    Math.abs(
                        b.relativeTop -
                        idealTop
                    ) * 2 +

                    b.text.length * .1;

                return (
                    aScore -
                    bScore
                );
            }
        );

        return (
            candidates[0].text
        );
    }

    // ============================================================
    // OPEN CHAT LIST
    // ============================================================

    function detectOpenChats() {

        const inputs =
            getChatInputs();

        const chats = [];

        const seenContainers =
            new Set();

        inputs.forEach(
            (input, index) => {

                const container =
                    findChatContainer(
                        input
                    );

                if (!container) {
                    return;
                }

                /*
                 * Avoid duplicate input detections belonging
                 * to the same Torn chat window.
                 */

                if (
                    seenContainers.has(
                        container
                    )
                ) {
                    return;
                }

                seenContainers.add(
                    container
                );

                const name =
                    detectChatName(
                        container,
                        input,
                        index
                    );

                chats.push({
                    input,
                    container,
                    name
                });
            }
        );

        /*
         * Match Torn's visible left-to-right window order.
         */

        chats.sort(
            (a, b) => {

                const ar =
                    a.container
                        .getBoundingClientRect();

                const br =
                    b.container
                        .getBoundingClientRect();

                return (
                    ar.left -
                    br.left
                );
            }
        );

        return chats;
    }

    // ============================================================
    // INSERT RESULT INTO CHAT
    // ============================================================

    function insertIntoChat(
        input,
        text
    ) {

        if (!input) {
            return false;
        }

        input.focus();

        if (
            input instanceof HTMLTextAreaElement ||
            input instanceof HTMLInputElement
        ) {

            try {

                const prototype =
                    Object.getPrototypeOf(
                        input
                    );

                const descriptor =
                    Object
                        .getOwnPropertyDescriptor(
                            prototype,
                            'value'
                        );

                if (
                    descriptor &&
                    descriptor.set
                ) {
                    descriptor
                        .set
                        .call(
                            input,
                            text
                        );
                } else {
                    input.value =
                        text;
                }

                input.dispatchEvent(
                    new Event(
                        'input',
                        {
                            bubbles: true
                        }
                    )
                );

                input.dispatchEvent(
                    new Event(
                        'change',
                        {
                            bubbles: true
                        }
                    )
                );

                return true;

            } catch (error) {

                console.error(
                    '[In-Flight Arcade] Chat insertion failed:',
                    error
                );

                return false;
            }
        }

        try {

            input.focus();

            const selection =
                window.getSelection();

            const range =
                document.createRange();

            range.selectNodeContents(
                input
            );

            range.deleteContents();

            const textNode =
                document.createTextNode(
                    text
                );

            input.appendChild(
                textNode
            );

            range.selectNodeContents(
                input
            );

            range.collapse(false);

            selection.removeAllRanges();

            selection.addRange(
                range
            );

            input.dispatchEvent(
                new InputEvent(
                    'input',
                    {
                        bubbles: true,
                        inputType:
                            'insertText',
                        data:
                            text
                    }
                )
            );

            return true;

        } catch (error) {

            console.error(
                '[In-Flight Arcade] Contenteditable insertion failed:',
                error
            );

            return false;
        }
    }

