    function getTornUsername() {

        const sidebars = [
            document.querySelector('#sidebarroot'),
            ...document.querySelectorAll(
                '[class*="sidebar"], [id*="sidebar"]'
            )
        ].filter(Boolean);

        for (const sidebar of sidebars) {

            const rect =
                sidebar.getBoundingClientRect();

            if (
                rect.width <= 0 ||
                rect.left > 350
            ) {
                continue;
            }

            const text =
                cleanText(sidebar.innerText);

            const match =
                text.match(
                    /\bName:\s*([A-Za-z0-9_-]{2,32})\b/i
                );

            if (match) {
                return match[1];
            }
        }

        const candidates =
            document.querySelectorAll(
                'div, span, li, p'
            );

        for (const el of candidates) {

            if (
                el.closest(`#${ROOT_ID}`) ||
                el.closest(`#${SHARE_ID}`)
            ) {
                continue;
            }

            const rect =
                el.getBoundingClientRect();

            if (
                rect.width <= 0 ||
                rect.height <= 0 ||
                rect.left > 350
            ) {
                continue;
            }

            const text =
                cleanText(el.textContent);

            const match =
                text.match(
                    /^Name:\s*([A-Za-z0-9_-]{2,32})$/i
                );

            if (match) {
                return match[1];
            }
        }

        return 'Player';
    }

    // ============================================================
    // FLIGHT INFORMATION
    // ============================================================

    function parseFlightLine(text) {

        text = cleanText(text);

        if (!text) {
            return null;
        }

        const match =
            text.match(
                /(.+?)\s+to\s+(.+?)\.\s*Remaining Flight Time\s*-\s*(\d{1,2}:\d{2}:\d{2})/i
            );

        if (!match) {
            return null;
        }

        const origin =
            cleanText(match[1]);

        const destination =
            cleanText(match[2]);

        if (
            origin.length > 50 ||
            destination.length > 50
        ) {
            return null;
        }

        return {
            origin,
            destination,
            itinerary:
                `${origin} → ${destination}`,
            remaining:
                match[3]
        };
    }

    function scrapeTravelInfo() {

        const candidates =
            [...document.querySelectorAll('body *')]
                .filter(el => {

                    if (
                        el.closest(`#${ROOT_ID}`) ||
                        el.closest(`#${BTN_ID}`) ||
                        el.closest(`#${SHARE_ID}`) ||
                        el.id === RESTORE_ID
                    ) {
                        return false;
                    }

                    const text =
                        cleanText(el.innerText);

                    return (
                        text &&
                        text.length < 250 &&
                        /Remaining Flight Time/i.test(text)
                    );
                })
                .sort(
                    (a, b) =>
                        cleanText(a.innerText).length -
                        cleanText(b.innerText).length
                );

        for (const el of candidates) {

            const parsed =
                parseFlightLine(
                    el.innerText
                );

            if (parsed) {
                return parsed;
            }
        }

        return {
            origin: 'Unknown',
            destination: 'Unknown',
            itinerary:
                'Flight information unavailable',
            remaining:
                '--:--:--'
        };
    }

