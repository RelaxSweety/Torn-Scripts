            );

        const status =
            panel.querySelector(
                '#tfa-chat-status'
            );

        let lastSignature =
            null;

        function renderChats() {

            if (
                !document.body.contains(
                    panel
                )
            ) {
                return;
            }

            const chats =
                detectOpenChats();

            const signature =
                chats
                    .map(
                        (chat, index) => {

                            const rect =
                                chat.container
                                    .getBoundingClientRect();

                            return (
                                `${index}:` +
                                `${chat.name}:` +
                                `${Math.round(rect.left)}:` +
                                `${Math.round(rect.top)}:` +
                                `${Math.round(rect.width)}:` +
                                `${Math.round(rect.height)}`
                            );
                        }
                    )
                    .join('|');

            if (
                signature ===
                lastSignature
            ) {
                return;
            }

            lastSignature =
                signature;

            list.innerHTML =
                '';

            if (
                chats.length === 0
            ) {

                status.textContent =
                    'No open chat detected. Open a Torn chat and it will appear here automatically.';

                list.innerHTML = `

<div class="noChats">
    Waiting for an open Torn chat...
</div>

`;

                return;
            }

            status.textContent =
                chats.length === 1
                    ? '1 open chat detected.'
                    : `${chats.length} open chats detected.`;

            chats.forEach(
                chat => {

                    const button =
                        document.createElement(
                            'button'
                        );

                    button.type =
                        'button';

                    button.className =
                        'chatChoice';

                    button.innerHTML = `

${escapeHtml(chat.name)}

<span class="chatSub">
    Click to place results in this chat
</span>

`;

                    button.addEventListener(
                        'click',
                        () => {

                            const success =
                                insertIntoChat(
                                    chat.input,
                                    pendingShare.message
                                );

                            if (success) {

                                pendingShare =
                                    null;

                                closeSharePanel();

                            } else {

                                status.textContent =
                                    'The chat was detected, but the result could not be inserted.';
                            }
                        }
                    );

                    list.appendChild(
                        button
                    );
                }
            );
        }

        panel
            .querySelector(
                '#tfa-copy-results'
            )
            .addEventListener(
                'click',
                async () => {

                    try {

                        await navigator
                            .clipboard
                            .writeText(
                                pendingShare.message
                            );

                        status.textContent =
                            'Results copied to clipboard.';

                    } catch {

                        window.prompt(
                            'Copy the results:',
                            pendingShare.message
                        );
                    }
                }
            );

        panel
            .querySelector(
                '#tfa-cancel-share'
            )
            .addEventListener(
                'click',
                () => {

                    pendingShare =
                        null;

                    closeSharePanel();
                }
            );

        renderChats();

        shareScanTimer =
            setInterval(
                renderChats,
                750
            );
    }

