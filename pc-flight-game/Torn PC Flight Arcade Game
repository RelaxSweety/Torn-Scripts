            );

        const closeButton =
            root.querySelector(
                '#tfa-close'
            );

        const message =
            root.querySelector(
                '#tfa-message'
            );

        let width = 1000;
        let height = 600;
        let dpr = 1;

        let paused = false;
        let minimized = false;
        let ended = false;

        let score = 0;
        let kills = 0;
        let health = 100;

        let playTime = 0;
        let elapsed = 0;

        let enemyTimer = 0;
        let cloudTimer = 0;

        let bullets = [];
        let enemies = [];
        let enemyBullets = [];
        let particles = [];
        let clouds = [];

        let animationFrame = 0;

        let last =
            performance.now();

        const keys =
            new Set();

        const previousHighScore =
            Number(
                localStorage.getItem(
                    HIGH_KEY
                ) || 0
            );

        let highScore =
            previousHighScore;

        const player = {
            x: 135,
            y: 300,
            width: 72,
            height: 34,
            speed: 330,
            cooldown: 0,
            invincible: 0
        };

        // ========================================================
        // LIVE FLIGHT INFO
        // ========================================================

        function updateFlightDisplay() {

            const info =
                scrapeTravelInfo();

            if (
                info.origin !== 'Unknown' &&
                info.destination !== 'Unknown'
            ) {
                routeEl.textContent =
                    info.itinerary;
            }

            if (
                info.remaining !==
                '--:--:--'
            ) {
                timeEl.textContent =
                    info.remaining;
            }
        }

        const travelTimer =
            setInterval(
                updateFlightDisplay,
                1000
            );

        // ========================================================
        // RESIZE
        // ========================================================

        function resize() {

            if (minimized) {
                return;
            }

            const rect =
                stage.getBoundingClientRect();

            dpr =
                Math.min(
                    devicePixelRatio || 1,
                    2
                );

            width =
                Math.max(
                    600,
                    Math.floor(
                        rect.width
                    )
                );

            height =
                Math.max(
                    360,
                    Math.floor(
                        rect.height
                    )
                );

            canvas.width =
                Math.floor(
                    width * dpr
                );

            canvas.height =
                Math.floor(
                    height * dpr
                );

            ctx.setTransform(
                dpr,
                0,
                0,
                dpr,
                0,
                0
            );
        }

        const resizeObserver =
            new ResizeObserver(
                resize
            );

        resizeObserver.observe(
            stage
        );

        resize();

        // ========================================================
        // COLLISION
        // ========================================================

        function collision(
            a,
            b,
            padding = 0
        ) {

            return (
                a.x + padding <
                    b.x +
                    b.width -
                    padding &&

                a.x +
                    a.width -
                    padding >
                    b.x +
                    padding &&

                a.y + padding <
                    b.y +
                    b.height -
                    padding &&

                a.y +
                    a.height -
                    padding >
                    b.y +
                    padding
            );
        }

        // ========================================================
        // PARTICLES
        // ========================================================

        function explosion(
            x,
            y,
            amount = 12
        ) {

            for (
                let i = 0;
                i < amount;
                i++
            ) {

                const angle =
                    Math.random() *
                    Math.PI *
                    2;

                const speed =
                    40 +
                    Math.random() *
                    190;

                particles.push({

                    x,
                    y,

                    vx:
                        Math.cos(angle) *
                        speed,

                    vy:
                        Math.sin(angle) *
                        speed,

                    life:
                        .3 +
                        Math.random() *
                        .6,

                    maxLife:
                        .9,

                    radius:
                        1 +
                        Math.random() *
                        4
                });
            }
        }

        // ========================================================
        // SHOOT
        // ========================================================

        function shoot() {

            bullets.push({

                x:
                    player.x + 62,

                y:
                    player.y + 16,

                width:
                    18,

                height:
                    4,

                vx:
                    690
            });

            player.cooldown =
                .13;
        }

        // ========================================================
        // ENEMY
        // ========================================================

        function spawnEnemy() {

            const tough =
                Math.random() <
                Math.min(
                    .12 +
                    elapsed / 240,
                    .32
                );

            enemies.push({

                x:
                    width + 30,

                y:
                    45 +
                    Math.random() *
                    (height - 110),

                width:
                    tough
                        ? 72
                        : 56,

                height:
                    tough
                        ? 32
                        : 26,

                vx:
                    -(
                        150 +
                        Math.random() *
                        80 +
                        Math.min(
                            elapsed * 1.1,
                            120
                        )
                    ),

                hp:
                    tough
                        ? 3
                        : 1,

                fire:
                    .6 +
                    Math.random() *
                    1.7,

                wave:
                    Math.random() *
                    Math.PI *
                    2,

                amplitude:
                    10 +
                    Math.random() *
                    25,

                tough
            });
        }

        // ========================================================
        // DAMAGE
        // ========================================================

        function damage(amount) {

            if (
                player.invincible > 0 ||
                ended
            ) {
                return;
            }

            health -= amount;

            player.invincible =
                .7;

            explosion(
                player.x + 30,
                player.y + 17,
                10
            );

            if (
                health <= 0
            ) {

                health = 0;

                finishGame(
                    'gameover'
                );
            }
        }

        // ========================================================
        // FINISH GAME
        // ========================================================

        function finishGame(reason) {

            if (ended) {
                return;
            }

            ended = true;
            paused = true;

            keys.clear();

            const finalScore =
                Math.floor(score);

            const isNewHigh =
                finalScore >
                previousHighScore;

            if (
                finalScore >
                highScore
            ) {
                highScore =
                    finalScore;
            }

